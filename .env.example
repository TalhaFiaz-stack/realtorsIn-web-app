# RealtorsIn Web App — environment template (Phase 1)
# Copy to `.env.local` for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public origin of this Next.js app (used for redirects / CSRF origin checks).
NEXT_PUBLIC_APP_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Social API (SocialProfileREM) — SERVER ONLY
# Do not expose SOCIAL_API_URL via NEXT_PUBLIC_*. Browser talks to same-origin BFF only.
# -----------------------------------------------------------------------------
# Production/staging API, or local backend:
# SOCIAL_API_URL=http://localhost:3000
SOCIAL_API_URL=https://api.realtorsin.com
# (Optional) Exposed to the browser as NEXT_PUBLIC_SOCIAL_FILES_BASE_URL via next.config
# for relative story/chat media paths — defaults from SOCIAL_API_URL at build/dev start.

# REM CRM node (property types, statuses — server-only BFF proxy)
# REM_CRM_API_URL=https://my.remapp.ae

# -----------------------------------------------------------------------------
# Off-plan catalog hosts (used in later phases; server-only)
# Mobile reference: NODE_BASE_URL_PROJECT / API_V2_BASE_URL
# -----------------------------------------------------------------------------
OFFPLAN_API_URL=https://off-plan.remapp.ae
OFFPLAN_API_V2_URL=https://apiv2.remapp.ae
# Optional: external REM map URL (not used by default; web map matches mobile MapViewComp)
# NEXT_PUBLIC_OFFPLAN_PORTAL_URL=https://off-plan.remapp.ae

# -----------------------------------------------------------------------------
# Session cookie (HttpOnly — never readable by JavaScript)
# -----------------------------------------------------------------------------
AUTH_COOKIE_NAME=ri_session
# Set true in production (HTTPS). Local http should use false.
SESSION_COOKIE_SECURE=false
# Max-Age seconds for the session cookie (default 30 days). Align with token TTL in Phase 2.
SESSION_COOKIE_MAX_AGE=2592000

# -----------------------------------------------------------------------------
# OAuth web client IDs (Phase 2+) — public identifiers only, not secrets
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Server-side OAuth secrets (Phase 2+) — never use NEXT_PUBLIC_
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Playwright / staging smoke (optional — never commit real passwords)
# -----------------------------------------------------------------------------
# E2E_BASE_URL=http://127.0.0.1:3002
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=

# Isolated production build output dir (see npm run build:isolated)
# NEXT_DIST_DIR=.next-build
