# RealtorsIn Web App — environment template
# Copy to `.env.local` for local development (or set these in your host's
# environment for staging / production). Never commit real secrets.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time —
# they must be public identifiers only. Restart `npm run dev` / rebuild after
# changing any of them.
#
# The session cookie (name `ri_session`, 30 days, HttpOnly, SameSite=Lax,
# Secure in production or on https) is fixed in code and is not configured here.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public origin of this Next.js app. Used for redirects and the CSRF origin
# check, so it must EXACTLY match the address people browse from (scheme +
# host + port, no trailing slash). Examples:
#   local:        http://localhost:3002
#   dev tunnel:   https://<your-tunnel>.devtunnels.ms
#   production:   https://app.your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Social API (SocialProfileREM) — SERVER ONLY
# Do not expose SOCIAL_API_URL via NEXT_PUBLIC_*. The browser only talks to this
# app's own /api routes (the BFF).
# -----------------------------------------------------------------------------
# Production/staging API, or your local backend:
# SOCIAL_API_URL=http://localhost:3000
SOCIAL_API_URL=https://api.realtorsin.com

# (Optional) Host used to load relative story / chat / job media paths in the
# browser. Defaults to SOCIAL_API_URL. Set it when the backend's public host
# differs from the URL the web server uses to reach it (e.g. a private address).
# NEXT_PUBLIC_SOCIAL_FILES_BASE_URL=

# -----------------------------------------------------------------------------
# Shared secret between this server (BFF) and SocialProfileREM
# -----------------------------------------------------------------------------
# Lets the backend trust the visitor IP / browser / platform that this server
# forwards. Use the SAME value as BFF_SHARED_SECRET in the backend's .env.
# At least 16 characters. Generate one with:  openssl rand -hex 32
# Without it the backend sees this server's IP for every visitor.
# In production your proxy must also set X-Forwarded-For / X-Real-IP and strip
# any client-supplied copies.
BFF_SHARED_SECRET=

# -----------------------------------------------------------------------------
# REM CRM and off-plan catalog — SERVER ONLY
# -----------------------------------------------------------------------------
# REM CRM node (property types, statuses, lead sync proxy). Defaults to the
# production REM host if unset — set it explicitly on staging.
# REM_CRM_API_URL=https://my.remapp.ae

# Off-plan catalog host. Mobile reference: NODE_BASE_URL_PROJECT.
# Defaults to the production host if unset — set it explicitly on staging.
OFFPLAN_API_URL=https://off-plan.remapp.ae
# Optional: external REM map URL (not used by default; the web map matches mobile).
# NEXT_PUBLIC_OFFPLAN_PORTAL_URL=https://off-plan.remapp.ae

# -----------------------------------------------------------------------------
# Social sign-in — public client identifiers, not secrets
# -----------------------------------------------------------------------------
# Google: the OAuth *web* client ID (Google Cloud Console → APIs & Services →
#   Credentials). Add your app origin (NEXT_PUBLIC_APP_URL) under "Authorized
#   JavaScript origins", otherwise sign-in fails with "origin_mismatch".
#   Must also be listed in the backend's GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Facebook: the app ID used for member sign-in (developers.facebook.com).
#   Turn on Facebook Login → Settings → "Login with the JavaScript SDK" and add
#   your app origin under "Allowed Domains for the JavaScript SDK".
#   Must also be listed in the backend's FACEBOOK_LOGIN_APP_IDS.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# -----------------------------------------------------------------------------
# Browser push notifications (Firebase Cloud Messaging) — public web-app config
# -----------------------------------------------------------------------------
# Create a *Web app* in the same Firebase project the backend sends from
# (Project settings → General → Your apps). Browser push is switched on when
# the first five values below are set. Backend: run migration 124 on its DB.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional but recommended for production: your own Web Push key pair
# (Project settings → Cloud Messaging → Web Push certificates). Without it the
# Firebase SDK uses its built-in default key.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# -----------------------------------------------------------------------------
# Build and test (all optional)
# -----------------------------------------------------------------------------
# Isolated production build output dir (see npm run build:isolated)
# NEXT_DIST_DIR=.next-build

# Playwright smoke tests. Never commit real passwords.
# E2E_BASE_URL=http://127.0.0.1:3002
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=

# Local-only stub for the /api/auth/dev-session route. Leave unset (the route
# then returns 404). Never enable in staging or production.
# ENABLE_DEV_SESSION=false
